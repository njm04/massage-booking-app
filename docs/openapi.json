{
  "openapi": "3.0.0",
  "info": {
    "title": "Massage Booking API",
    "version": "1.0.0",
    "description": "API documentation for the massage booking application"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "xAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-auth-token"
      }
    }
  },
  "security": [
    {
      "xAuthToken": []
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Get all users",
        "tags": ["Users"],
        "responses": {
          "200": {
            "description": "A list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a user",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["firstName", "lastName", "email", "birthDate", "gender", "password"],
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "email": { "type": "string" },
                  "birthDate": { "type": "string", "format": "date" },
                  "gender": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created successfully"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get the current authenticated user",
        "tags": ["Users"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile"
          }
        }
      }
    },
    "/api/users/create-user": {
      "post": {
        "summary": "Create a user as an admin",
        "tags": ["Users"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["firstName", "lastName", "email", "birthDate", "gender", "password", "userType"],
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "email": { "type": "string" },
                  "birthDate": { "type": "string", "format": "date" },
                  "gender": { "type": "string" },
                  "password": { "type": "string" },
                  "userType": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created successfully by admin"
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "summary": "Get bookings for the current user",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of bookings"
          }
        }
      },
      "post": {
        "summary": "Create a booking",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["therapist", "massageType", "duration", "contactNumber", "address", "state", "city", "zip", "date"],
                "properties": {
                  "therapist": { "type": "string" },
                  "massageType": { "type": "string" },
                  "duration": { "type": "number" },
                  "contactNumber": { "type": "string" },
                  "address": { "type": "string" },
                  "addressTwo": { "type": "string" },
                  "state": { "type": "string" },
                  "city": { "type": "string" },
                  "zip": { "type": "string" },
                  "date": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking created successfully"
          }
        }
      }
    },
    "/api/bookings/{id}": {
      "put": {
        "summary": "Update a booking",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking updated successfully"
          }
        }
      }
    },
    "/api/bookings/delete/{id}": {
      "put": {
        "summary": "Delete or cancel a booking",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking deletion status updated"
          }
        }
      }
    },
    "/api/bookings/update-view/{id}": {
      "get": {
        "summary": "Get a booking for update view",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking retrieved"
          }
        }
      }
    },
    "/api/bookings/update-status/{id}": {
      "put": {
        "summary": "Update booking status",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking status updated"
          }
        }
      }
    },
    "/api/auth": {
      "post": {
        "summary": "Authenticate a user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful"
          }
        }
      }
    },
    "/api/auth/confirmation/{token}": {
      "get": {
        "summary": "Confirm a user email",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email confirmation response"
          }
        }
      }
    },
    "/api/user-types": {
      "get": {
        "summary": "Get all user types",
        "tags": ["User Types"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of user types"
          }
        }
      },
      "post": {
        "summary": "Create a user type",
        "tags": ["User Types"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User type created"
          }
        }
      }
    }
  }
}
