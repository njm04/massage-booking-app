{
  "openapi": "3.0.0",
  "info": {
    "title": "Massage Booking API",
    "version": "1.0.0",
    "description": "API documentation for the massage booking application"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "xAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-auth-token"
      }
    }
  },
  "security": [
    {
      "xAuthToken": []
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Get all users",
        "description": "Admin-only endpoint that returns all users from the database.",
        "tags": ["Users"],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or account is inactive"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      },
      "post": {
        "summary": "Register a customer",
        "description": "Public customer registration endpoint. The server assigns the default customer user type and unverified status.",
        "tags": ["Users"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "firstName",
                  "lastName",
                  "email",
                  "birthDate",
                  "gender",
                  "password"
                ],
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "birthDate": { "type": "string", "format": "date" },
                  "gender": { "type": "string" },
                  "password": { "type": "string", "minLength": 5 },
                  "userType": {
                    "type": "string",
                    "description": "Ignored for public registration; the server assigns the customer user type."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Validation error or duplicate user"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      }
    },
    "/api/therapists": {
      "get": {
        "summary": "List active therapists",
        "description": "Returns active, non-deleted therapists for authenticated administrators, customers, and therapists. This version does not accept query parameters and does not expose availability, reservations, or private account fields.",
        "tags": ["Therapists"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active therapists sorted by first name, last name, and ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["_id", "firstName", "lastName"],
                    "additionalProperties": false,
                    "properties": {
                      "_id": { "type": "string" },
                      "firstName": { "type": "string" },
                      "lastName": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or account is inactive"
          },
          "403": {
            "description": "The authenticated account has no supported therapist-directory role"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get the authenticated user",
        "description": "Returns the currently authenticated user profile without sensitive fields such as password.",
        "tags": ["Users"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/users/create-user": {
      "post": {
        "summary": "Create a user as an admin",
        "description": "Admin-only endpoint for creating a customer, therapist, or general user. The API sends an email confirmation attempt for created users when applicable.",
        "tags": ["Users"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "firstName",
                  "lastName",
                  "email",
                  "birthDate",
                  "gender",
                  "password",
                  "userType"
                ],
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "birthDate": { "type": "string", "format": "date" },
                  "gender": { "type": "string" },
                  "password": { "type": "string", "minLength": 5 },
                  "userType": {
                    "type": "string",
                    "description": "UserType ObjectId"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Validation error, invalid user type, or duplicate user"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      }
    },
    "/api/users/{id}": {
      "put": {
        "summary": "Update a user by id",
        "description": "Admin-only endpoint that updates basic profile details for a user. Therapist accounts cannot be suspended while they still have reservations.",
        "tags": ["Users"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "firstName",
                  "lastName",
                  "birthDate",
                  "gender",
                  "status"
                ],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "birthDate": { "type": "string", "format": "date" },
                  "gender": { "type": "string" },
                  "status": {
                    "type": "string",
                    "enum": ["active", "suspend", "unverified"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully"
          },
          "400": {
            "description": "Validation error, invalid user, or business-rule validation failure"
          },
          "403": {
            "description": "Admin access required"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      },
      "delete": {
        "summary": "Delete a user by id",
        "description": "Admin-only endpoint that permanently removes the user record from the database.",
        "tags": ["Users"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/users/change-password/{id}": {
      "put": {
        "summary": "Change a user's password",
        "description": "Only the authenticated user matching the target user ID can change that password. Requests from other users receive a 403 response.",
        "tags": ["Users"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password",
                  "newPassword",
                  "newPasswordConfirmation"
                ],
                "properties": {
                  "password": { "type": "string" },
                  "newPassword": { "type": "string" },
                  "newPasswordConfirmation": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed successfully"
          },
          "400": {
            "description": "Validation error or mismatched password confirmation"
          },
          "403": {
            "description": "Authenticated user is not allowed to change this password"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/users/update-status/{id}": {
      "put": {
        "summary": "Update a user's status",
        "description": "Admin-only status update. If a therapist is suspended, active reservations block the request; if a customer is suspended, active bookings block the request.",
        "tags": ["Users"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["active", "suspend"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated successfully"
          },
          "400": {
            "description": "Validation error or business-rule block"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "summary": "Get bookings for the current user",
        "description": "Returns bookings filtered by the authenticated user's role: admin gets all active bookings, customer gets their own bookings, and therapist gets bookings assigned to them.",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of bookings"
          },
          "403": {
            "description": "The authenticated account has no supported booking role"
          }
        }
      },
      "post": {
        "summary": "Create a booking",
        "description": "Customers may create a booking for themselves, and admins may create one for a customer selected by email. Therapists cannot create customer bookings.",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "therapist",
                  "massageType",
                  "duration",
                  "contactNumber",
                  "address",
                  "state",
                  "city",
                  "zip",
                  "date"
                ],
                "properties": {
                  "therapist": {
                    "type": "string",
                    "description": "Therapist ObjectId"
                  },
                  "massageType": { "type": "string" },
                  "duration": {
                    "type": "number",
                    "minimum": 60,
                    "maximum": 120
                  },
                  "contactNumber": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 20
                  },
                  "address": { "type": "string", "minLength": 3 },
                  "addressTwo": {
                    "type": "string",
                    "maxLength": 10,
                    "nullable": true
                  },
                  "state": { "type": "string" },
                  "city": { "type": "string", "minLength": 3 },
                  "zip": { "type": "string", "minLength": 6 },
                  "date": { "type": "string", "format": "date-time" },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Required when admin books for a different customer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking created successfully"
          },
          "400": {
            "description": "Validation error, invalid therapist, invalid user type, or customer not found"
          },
          "403": {
            "description": "Only customers and admins may create bookings"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      }
    },
    "/api/bookings/today": {
      "get": {
        "summary": "Get today's bookings",
        "description": "Returns non-deleted, non-cancelled bookings scheduled for the current server calendar day. Admin access is required.",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Today's bookings and total count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["bookings", "total"],
                  "properties": {
                    "bookings": {
                      "type": "array",
                      "items": { "type": "object" }
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },
    "/api/bookings/{id}": {
      "put": {
        "summary": "Update a booking",
        "description": "Customers may update their own booking and admins may update any booking. Therapists must use the assignment-scoped status endpoint and cannot edit customer, scheduling, or therapist-assignment fields. When therapist is changed, the server derives the previous therapist from the stored booking rather than accepting a previous-therapist identifier from the request.",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "therapist",
                  "massageType",
                  "duration",
                  "contactNumber",
                  "address",
                  "state",
                  "city",
                  "zip",
                  "date"
                ],
                "properties": {
                  "therapist": { "type": "string" },
                  "massageType": { "type": "string" },
                  "duration": { "type": "number" },
                  "contactNumber": { "type": "string" },
                  "address": { "type": "string" },
                  "addressTwo": { "type": "string" },
                  "state": { "type": "string" },
                  "city": { "type": "string" },
                  "zip": { "type": "string" },
                  "date": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking updated successfully"
          },
          "400": {
            "description": "Validation error or therapist not found"
          },
          "403": {
            "description": "Only the owning customer or an admin may fully edit a booking"
          },
          "404": {
            "description": "Booking not found in the caller's authorized scope"
          }
        }
      }
    },
    "/api/bookings/delete/{id}": {
      "put": {
        "summary": "Delete or cancel a booking",
        "description": "Customers may cancel only their own booking at least 24 hours before the appointment. Admins may cancel at any time. Therapists cannot cancel customer appointments. A booking outside a customer's scope is returned as not found. Customer cancellations set status to cancelled; admin cancellations soft-delete the booking with isDeleted = true.",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking deletion or cancellation applied"
          },
          "400": {
            "description": "Booking is within the customer's 24-hour cancellation window"
          },
          "403": {
            "description": "Therapists cannot cancel bookings, or the authenticated account has no supported role"
          },
          "404": {
            "description": "Booking not found in the caller's authorized scope"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      }
    },
    "/api/bookings/update-view/{id}": {
      "get": {
        "summary": "Get a booking for edit view",
        "description": "Retrieves an active booking for an update form when it belongs to the authenticated customer, is assigned to the authenticated therapist, or the caller is an admin.",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking retrieved"
          },
          "403": {
            "description": "The authenticated account has no supported booking role"
          },
          "404": {
            "description": "Booking not found in the caller's authorized scope"
          }
        }
      }
    },
    "/api/bookings/update-status/{id}": {
      "put": {
        "summary": "Update booking status",
        "description": "Therapist-only route for moving an assigned booking between status values. A booking assigned to another therapist is returned as not found. Completed bookings also remove the reservation from the therapist profile and commit in a transaction.",
        "tags": ["Bookings"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "Booking status value. Any value is accepted by validation, but the real flow uses values like pending, ongoing, completed, and cancelled."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking status updated"
          },
          "400": {
            "description": "Validation error"
          },
          "403": {
            "description": "Therapist access required"
          },
          "404": {
            "description": "Booking not found among the therapist's assignments"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      }
    },
    "/api/auth": {
      "post": {
        "summary": "Authenticate a user",
        "description": "Logs in a user by email and password and returns the JWT token in the response body.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful"
          },
          "400": {
            "description": "Invalid credentials or email not confirmed"
          },
          "429": {
            "description": "Too many login attempts for this IP and email combination"
          }
        }
      }
    },
    "/api/auth/confirmation/{token}": {
      "get": {
        "summary": "Confirm a user email",
        "description": "Verifies and activates a customer account after receipt of a confirmation token.",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email confirmation response"
          },
          "500": {
            "description": "Token verification or update failed"
          }
        }
      }
    },
    "/api/user-types": {
      "get": {
        "summary": "Get all user types",
        "description": "Admin-only endpoint that returns available user types.",
        "tags": ["User Types"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of user types"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      },
      "post": {
        "summary": "Create a user type",
        "description": "Admin-only endpoint that creates a user type.",
        "tags": ["User Types"],
        "security": [
          {
            "xAuthToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User type created"
          },
          "400": {
            "description": "Validation error or duplicate type"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    }
  }
}
